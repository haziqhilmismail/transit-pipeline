# Copy to .env. These are local-only defaults.
AIRFLOW_UID=50000
POSTGRES_USER=transit
POSTGRES_PASSWORD=transit
AIRFLOW_JWT_SECRET=change-me-to-a-long-random-string
# Host folder that holds the hoarder's realtime/ and static/ folders. Only those two are mounted, read-only.
TRANSIT_DATA=/path/to/gtfs-hoarder/data
