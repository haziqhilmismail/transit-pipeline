AIRFLOW_UID=50000
POSTGRES_USER=transit
# Use only URL-safe characters (letters, digits, - . _ ~): the password goes into connection URLs unencoded.
POSTGRES_PASSWORD=transit
AIRFLOW_JWT_SECRET=change-me-to-a-long-random-string
TRANSIT_DATA=/path/to/gtfs-hoarder/data
# The daily ingest loads closed archive days not loaded yet, from this date on.
TRANSIT_EARLIEST_DATE=2026-11-18
# Gap repair from collector B: off or dry (log the decisions, write nothing).
# "on" needs the scheduler's read-write archive mount, which is not wired yet.
TRANSIT_REPAIR=dry
# Public stats API (PostgREST). `make up` needs this value and STATS_SITE_HOSTS; other targets do not. Same character rule as POSTGRES_PASSWORD.
API_DB_PASSWORD=change-me
# Host names the stats site answers to (space separated). Any other Host header gets 421.
STATS_SITE_HOSTS=transit.example.com localhost 127.0.0.1
# Checkout of the transit-dashboard repo's site/ folder.
DASHBOARD_SITE=../transit-dashboard/site
# Optional. Folder with the Cloudflare tunnel's config.yml and credentials file (config.yml names them under
# /etc/cloudflared). Empty: `make up` starts no tunnel.
STATS_TUNNEL_DIR=
# The uid that owns the files in STATS_TUNNEL_DIR.
STATS_TUNNEL_UID=1000
